{
  "appId": "net.munea.app",
  "appName": "Munea",
  "webDir": "web",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 20000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#F4F0E8",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_munea_reminder",
      "iconColor": "#3AA8A0"
    }
  },
  "ios": {
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/splash-screen"
    ]
  }
}
