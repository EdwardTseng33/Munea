        "home.care.acknowledge",
        "home.care.open",
        "home.care.demoRelay",
        "home.care.familyFallback",
        "home.care.activityFallback",
        "home.care.walkTitle",
        "home.care.walkGap",
        "home.care.walkComplete",
        "home.care.activityTitle",
        "home.care.activityProgress",
        "home.care.visitFallback",
        "home.care.visitSoon",
        "home.care.visitNote",
        "home.care.medicationRhythm",
        "home.care.remove",
        "home.care.report"
      ]
    },
    {
      "anchorId": "pillTitle",
      "renderer": "renderPillTask",
      "keys": [
        "medication.genericName",
        "medication.takeName",
        "medication.taskProgress",
        "medication.allDone",
        "medication.completedToday",
        "medication.slot.afterBreakfast",
        "medication.slot.afterLunch",
        "medication.slot.afterDinner",
        "medication.slot.bedtime"
      ]
    },
    {
      "anchorId": "medMgrModal",
      "renderer": "localizeMedicationSurfaces",
      "keys": [
        "medication.title",
        "medication.namePlaceholder",
        "medication.genericName",
        "medication.slot.afterBreakfast",
        "medication.slot.afterLunch",
        "medication.slot.afterDinner",
        "medication.slot.bedtime",
        "medication.duration.days",
        "medication.duration.longTerm",
        "medication.duration.daily",
        "medicationManager.subtitle",
        "medicationManager.addMedicine",
        "medicationManager.photo",
        "medicationManager.photoHint",
        "medicationManager.scheduleMultiple",
        "medicationManager.duration",
        "medicationManager.add",
        "medicationManager.disclaimer",
        "medicationManager.close",
        "medicationManager.emptySlot",
        "medicationManager.medicineCountOne",
        "medicationManager.medicineCountOther",
        "medicationManager.reminderTime",
        "medicationManager.removeSlot",
        "medicationManager.removedToast",
        "medicationManager.photoReadError",
        "medicationManager.nameRequired",
        "medicationManager.scheduleRequired",
        "medicationManager.addedToast"
