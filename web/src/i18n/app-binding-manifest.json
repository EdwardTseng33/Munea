    {
      "anchorId": "eventTask",
      "renderer": "renderEventTask",
      "keys": [
        "event.familyTitle",
        "event.arriveOnTime",
        "common.today"
      ]
    },
    {
      "anchorId": "walkSub",
      "renderer": "renderWalkProgress",
      "keys": [
        "home.walkProgressMet",
        "home.walkProgress",
        "home.walkGoalMet",
        "home.walkSteps"
      ]
    },
    {
      "anchorId": "ptsLeft",
      "renderer": "renderPoints",
