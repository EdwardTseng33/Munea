        "credits.exhaustedBody",
        "credits.freeTrialEnded",
        "settings.topUpCredits",
        "common.notNow"
      ]
    },
    {
      "anchorId": "callTimer",
      "renderer": "startCallTimer",
      "keys": [
        "credits.freeTrialOneMinute",
        "credits.freeTrialEnded"
      ]
    }
