  "dynamicBindings": [
    {
      "anchorId": "setPlanName",
      "renderer": "renderPlanState",
      "keys": [
        "settings.planName",
        "settings.managePlan",
        "settings.upgradePlan",
        "subscription.planFree",
        "subscription.planPlus",
        "subscription.planPro",
        "subscription.monthlyCreditsNote",
        "subscription.freeCreditsLeft",
        "subscription.freePlanNote"
      ]
    },
    {
      "anchorId": "chatCaption",
      "renderer": "setCallHint",
      "keys": ["voice.ready", "voice.connecting", "voice.fallback", "voice.call.unavailable"]
    },
    {
      "anchorId": "chatCaption",
      "renderer": "setLocalizedRuntimeHint",
      "keys": [
        "voice.runtime.playbackBlocked",
        "voice.runtime.audioOnlyFallback",
        "voice.runtime.microphoneTapToResume",
        "voice.runtime.listening",
        "voice.runtime.reconnecting",
        "voice.runtime.microphonePermission",
        "voice.runtime.heard",
        "voice.runtime.thinking",
        "voice.runtime.didNotHear",
        "voice.runtime.recordingTapWhenDone",
        "voice.runtime.microphoneMuted",
        "voice.runtime.microphoneMutedHint"
      ]
    },
    {
      "anchorId": "chat",
      "renderer": "setLocalizedRuntimeCaption",
      "keys": [
        "voice.runtime.recoveredTitle",
        "voice.runtime.recoveredBody",
        "voice.runtime.degradedTitle",
        "voice.runtime.degradedBody"
      ]
    },
    {
      "anchorId": "busyCardTitle",
      "renderer": "showBusyCard",
      "keys": [
        "voice.queue.preparingWithCompanion",
        "voice.queue.busyWithCompanion",
        "voice.queue.position",
        "voice.queue.etaPreparingSoon",
        "voice.queue.etaWaitingSoon",
        "voice.queue.etaPreparingMinutes",
        "voice.queue.etaWaitingMinutes",
        "voice.queue.etaPreparingUnknown",
        "voice.queue.etaWaitingUnknown",
        "voice.queue.note",
        "voice.queue.cancel",
        "voice.queue.pending",
        "voice.queue.wait",
        "voice.queue.fullTitle",
        "voice.queue.fullBody",
        "common.okay"
      ]
    },
    {
      "anchorId": "busyCardTitle",
      "renderer": "showCallStatusCard",
      "keys": [
        "voice.call.unavailable",
        "voice.call.retryLater",
        "voice.call.microphoneHttpsTitle",
        "voice.call.microphoneHttpsNote",
        "voice.call.microphonePermissionTitle",
        "voice.call.microphonePermissionNote",
        "voice.call.authExpiredTitle",
        "voice.call.authExpiredNote",
        "voice.call.accountPreparingTitle",
        "voice.call.accountPreparingNote",
        "voice.call.serviceUpdatingTitle",
        "voice.call.serviceUpdatingNote",
        "voice.call.serviceBusyNote",
        "voice.call.activationPendingTitle",
        "voice.call.readinessPendingTitle",
        "voice.call.readinessPendingNote",
        "voice.call.disconnectedTitle",
        "voice.call.disconnectedNote",
        "auth.signInAgain",
        "common.okay"
      ]
    },
    {
      "anchorId": "subCta",
      "renderer": "renderSubUI",
      "keys": [
        "subscription.currentPlanCta",
        "subscription.upgradeTo",
        "subscription.changeTo"
      ]
    },
    {
      "anchorId": "tuBuyBtn2",
      "renderer": "renderSubUI",
      "keys": ["purchase.buyCredits", "purchase.storeUnavailable", "purchase.loadingProducts"]
    },
    {
      "anchorId": "planConfirmText",
      "renderer": "planConfirmHtml",
      "keys": [
        "subscription.confirmTitle",
        "subscription.confirmBody",
        "subscription.confirmFacts",
        "subscription.confirmAction",
        "subscription.cancel"
      ]
    },
    {
      "anchorId": "authMessage",
      "renderer": "openAuthSheet",
      "keys": ["auth.inProgress", "auth.cancelled", "auth.unavailable", "auth.chatSignInRequired"]
    },
    {
      "anchorId": "authSheet",
      "renderer": "localizeAuthTerms",
      "keys": [
        "auth.termsPrefix",
        "auth.termsLink",
        "auth.aiProcessingDisclosure",
        "accessibility.close"
      ]
    },
    {
      "anchorId": "readerBody",
      "renderer": "openInAppReader",
      "keys": [
        "reader.privacyTitle",
        "reader.termsTitle",
        "reader.loading",
        "reader.loadError"
      ]
    },
    {
      "anchorId": "captionToggle",
      "renderer": "localizeChatControls",
      "keys": ["voice.caption.enabled", "voice.caption.disabled", "voice.caption.label", "voice.microphone.label", "accessibility.toggleCaptions", "accessibility.toggleMicrophone"]
    },
    {
      "anchorId": "careBody",
      "renderer": "buildCareItems",
